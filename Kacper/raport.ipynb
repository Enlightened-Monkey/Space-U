    ")\n",
    "\n",
    "ax = zyski_koszta.plot.bar(\n",
    "    y=['zysk', 'koszt'],\n",
    "    title='Średni koszt i zysk na wyprawach',\n",
    "    ylabel='Kwota [zł]',\n",
    "    xlabel='Nazwa wyprawy',\n",
    "    figsize=(10, 6),\n",
    ")\n",
    "\n",
    "ax.set_xticklabels(ax.get_xticklabels(), rotation=45, ha='right');"
   ]
