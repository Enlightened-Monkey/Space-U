     "output_type": "display_data"
    }
   ],
   "source": [
    "zyski_koszta =  top_5_trips_kind_customers_df.join(\n",
    "    top_5_trips_kind_details_df.set_index('trip_id'),\n",
    "    on='trip_id',\n",
    "    lsuffix='_customer',\n",
    "    rsuffix='_details'\n",
    ").groupby('trip_id').agg(\n",
    "    _payout =('ticket_price', 'sum'),\n",
    "    _cost = ('organization_cost', 'first'),\n",
    "    name = ('name', 'first'),\n",
    ").groupby('name').agg(\n",
    "    zysk = ('_payout', 'mean'),\n",
