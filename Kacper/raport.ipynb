   "source": [
    "## 1. Znajdź najpopularniejsze rodzaje wypraw, porównaj koszta i zyski, czy są opłacalne?"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "09499521",
   "metadata": {},
   "source": [
    "Wybierzmy 5 najpopularniejszych wypraw."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "e2659e11",
   "metadata": {},
   "outputs": [],
   "source": [
    "top_5_trips_query = \"\"\"\n",
    "SELECT name, COUNT(*) as trip_count\n",
    "FROM Trips\n",
    "GROUP BY name\n",
    "ORDER BY COUNT(*) DESC\n",
    "LIMIT 5\n",
    "\"\"\"\n",
    "cursor.execute(top_5_trips_query)\n",
    "trips = cursor.fetchall()\n",
    "top_5_trips_df = pd.DataFrame(trips, columns=[i[0] for i in cursor.description])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f70636cf",
   "metadata": {},
   "outputs": [],
   "source": [
    "top_5_trips_kind_customers_df = pd.DataFrame()\n",
    "top_5_trips_kind_details_df = pd.DataFrame()\n",
    "\n",
    "for name in top_5_trips_df['name'].values:\n",
    "    named_trips_query = f\"\"\"\n",
    "    SELECT trip_id, organization_cost, launch_date, name\n",
    "    FROM Trips\n",
    "    WHERE name = '{name}'\n",
    "    \"\"\"\n",
    "    cursor.execute(named_trips_query)\n",
    "    trip_data = cursor.fetchall()\n",
    "\n",
    "    top_5_trips_kind_details_df = pd.concat([top_5_trips_kind_details_df, pd.DataFrame(trip_data, columns=[i[0] for i in cursor.description])])\n",
    "\n",
    "    for trip_id, *_ in trip_data:\n",
    "\n",
    "        trip_query = f\"\"\"\n",
    "        SELECT participant_id, pesel, trip_id, ticket_price\n",
    "        FROM TripParticipants \n",
    "        WHERE trip_id = {trip_id}\n",
    "        \"\"\"\n",
    "        cursor.execute(trip_query)\n",
    "        participants = cursor.fetchall()\n",
    "        top_5_trips_kind_customers_df = pd.concat([top_5_trips_kind_customers_df, pd.DataFrame(participants, columns=[i[0] for i in cursor.description])])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "a67559e7",
   "metadata": {},
   "outputs": [
    {
     "data": {
